# Backend Environment Configuration

# Database connection (SQLite is default for demo, no setup required)
# Uncomment below lines for PostgreSQL production setup:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/water_twin
# DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/water_twin

# API configuration
API_PREFIX=/api
DEBUG=true

# Auto-seed demo data on startup (only for SQLite mode)
ENABLE_SEED_DATA=true

# GIS Data Directory (platform-specific absolute path)
# Store large GIS data outside project root for cross-platform development
# Windows:  GIS_DATA_DIR=D:\para\data\gis-data
# macOS:    GIS_DATA_DIR=/Users/xxx/data/gis-data
# Ubuntu:   GIS_DATA_DIR=/home/xxx/data/gis-data
# GIS_DATA_DIR=

# ===== GeoScene Server - REQUIRED (system will not start without these) =====
# GeoScene Server 地址（例：http://192.168.1.100:6443/arcgis）
GEOSCENE_SERVER_URL=
# FeatureServer 地址（例：http://192.168.1.100:6443/arcgis/rest/services/OrangeTrees/FeatureServer）
GEOSCENE_FEATURE_SERVER_URL=
# GeoScene Server 管理员账号
GEOSCENE_USERNAME=
# GeoScene Server 管理员密码
GEOSCENE_PASSWORD=
