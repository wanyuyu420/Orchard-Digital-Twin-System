# 前端环境变量配置

# 后端 API 代理目标地址 (例如 http://127.0.0.1:8000)
VITE_API_TARGET=http://127.0.0.1:8000

# API 基础路径
VITE_API_BASE_URL=/api/v1

# 天地图 API Key (请在 https://console.tianditu.gov.cn/ 申请)
VITE_TIANDITU_KEY=YOUR_TIANDITU_KEY

# Cesium Ion Token (请在 https://cesium.com/ion/tokens 申请)
# 用于加载全球地形、3D Tiles 等 Cesium Ion 资源
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN