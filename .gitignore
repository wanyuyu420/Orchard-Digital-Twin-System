# ========================================
# Git 忽略规则 - 通用（所有开发者必须）
# ========================================

# 依赖目录
node_modules/
dist/

# 日志文件
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 敏感信息（必须忽略，每个开发者有自己的值）
.env
.env.local
.env.*.local
backend/.env

# Python 
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/

# 缓存
.cache/
.eslintcache
*.tsbuildinfo

# 临时文件
*.tmp
*.temp

# 测试覆盖率
coverage/
.nyc_output/

# 个人文档和笔记（敏感信息）
上一次.txt
上次记录.txt
# CLAUDE.md - 已移除忽略，用于项目共享配置
AGENTS.md
*.local.md

# Chat 日志和临时分析
chat-*.txt
GIS_CODE.md

# Cesium 库管理
# 注：Cesium-1.136-epawse 是定制版本，需要上传
# 只排除官方的 1.82 版本
public/Cesium-1.82-epawse/

# 数据文件（真实项目数据）
backend/data/
*.sqlite
*.db
*.xlsx
*.xls

# 真实数据处理脚本
backend/scripts/import_excel.py
backend/scripts/ingest_hydrological.py
backend/app/utils/excel_importer.py
backend/app/utils/reader.py
backend/app/utils/scanner.py

# AI 助手配置和开发过程文档
# .claude/ - 已移除忽略，用于项目共享配置
.claude/settings.local.json  # 个人权限设置仍然忽略
.gemini/
.agent/

# ========================================
# 可选忽略规则（根据个人工具调整）
