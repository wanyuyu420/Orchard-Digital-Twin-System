# ========================================
# 扩展建议
# ========================================
# 如果您有其他不想提交的文件：
# 1. 在本地修改此文件
# 2. 运行: git update-index --assume-unchanged <file> 
# 3. 记得在项目 wiki 或文档中说明这些本地忽略
#
# 本地忽略不会被提交到 git，其他开发者的设置完全独立
# CLAUDE.md - 已移除忽略，用于项目共享配置
# AGENTS.md - 已移至 openspec/AGENTS.md
_context/

# 第三方库的 npm 包目录（有独立 git）
public/cesium-draw/

# ========================================
# AI Agent 和文档目录（不需要版本控制）
# ========================================

# OpenSpec 规格文档（AI agent 生成，本地管理）
openspec/

# 开发日志（本地记录）
devlogs/

# 项目文档（可能包含敏感内容或草稿）
docs/

# Claude AI 配置目录
.claude/

# Skills 知识库
skills/

