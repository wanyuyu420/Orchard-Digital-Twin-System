{
  "name": "water-digital-new",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/leaflet": "^1.9.21",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.13.2",
    "cesium": "^1.104.0",
    "cesium-navigation-es6": "^3.0.9",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.1",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "proj4": "^2.20.8",
    "vite-plugin-external": "^6.2.2",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^4.0.15",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.3",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "sass": "^1.71.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.15",
    "vue-tsc": "^2.0.0"
  }
}
